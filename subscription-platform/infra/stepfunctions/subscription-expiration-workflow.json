{
  "Comment": "Waits 5 seconds then expires the user subscription",
  "StartAt": "WaitSubscription",
  "States": {
    "WaitSubscription": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "ExpireSubscription"
    },
    "ExpireSubscription": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:135527764587:function:expirationLambda",
      "End": true
    }
  }
}